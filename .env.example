# API Key (e.g. sk-..., or OpenRouter sk-or-v1-...)
# Set to 'mock' to run the backend 100% locally and offline.
DEEPSEEK_API_KEY=mock

# Completions endpoint URL (OpenAI baseURL + /chat/completions)
# Default DeepSeek Proxy: https://api.hcnsec.cn/v1/chat/completions
# OpenRouter Proxy: https://openrouter.ai/api/v1/chat/completions
# MiniMax Host (US): https://api.minimax.io/v1/chat/completions
# MiniMax Host (CN): https://api.minimaxi.com/v1/chat/completions
DEEPSEEK_API_URL=https://api.hcnsec.cn/v1/chat/completions

# Model name configuration (e.g. minimax/minimax-m3:free, DeepSeek-V4-Flash)
DEEPSEEK_MODEL=DeepSeek-V4-Flash

# Backend Server URL (Frontend references this)
NEXT_PUBLIC_API_URL=http://localhost:8000
